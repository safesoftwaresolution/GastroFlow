<%- include('../partials/layout/head', { titulo: 'Cocina' }) %>
    <link rel="stylesheet" href="/css/modulos/cocina.css?v=<%= assetV %>">
    <link rel="stylesheet" href="/css/modulos/kds.css?v=<%= assetV %>">
</head>

<body data-user-role="<%= user && user.rol ? user.rol : '' %>">
    <%- include('../partials/navbar', { user: typeof user !=='undefined' ? user : null, tenant: typeof tenant
        !=='undefined' ? tenant : null }) %>

        <div class="container-fluid px-3 px-md-4">
            <h4 class="mb-3"><i class="bi bi-egg-fried me-2"></i>Cola de Cocina</h4>
            <%- include('_tabs') %>
        </div>

        <!-- Data island: estaciones activas del tenant, ya ordenadas (para el modo "Por estación") -->
        <script type="application/json" id="kds-estaciones-data"><%- jsonSeguro(estaciones || []) %></script>

        <%- include('../partials/layout/scripts', { jquery: true, swal: true }) %>
        <script src="/js/modulos/cocina.js?v=<%= assetV %>"></script>
</body>

</html>