<%- include('../partials/layout/head', { titulo: 'Consolidado de sucursales - ' + tenant.nombre }) %>
</head>

<body class="bg-light">
    <%- include('../partials/navbar', { user: user, tenant: tenant }) %>

    <div class="container py-4" id="consolidadoApp">
        <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
            <div>
                <h2 class="fw-bold"><i class="bi bi-bar-chart-line me-2 text-primary"></i>Consolidado de ventas</h2>
                <p class="text-muted mb-0">
                    Ventas de <strong><%= tenant.nombre %></strong> y de todas sus sucursales juntas. Solo ves totales:
                    el detalle de cada venta se consulta dentro de cada sucursal.
                </p>
            </div>
            <a href="/sucursales" class="btn btn-outline-secondary"><i class="bi bi-diagram-3 me-1"></i>Mis sucursales</a>
        </div>

        <div class="card border-0 shadow-sm rounded-4 mb-4">
            <div class="card-body">
                <form id="formRango" class="row g-2 align-items-end">
                    <div class="col-6 col-md-3">
                        <label class="form-label small text-muted mb-1" for="fDesde">Desde</label>
                        <input class="form-control" type="date" id="fDesde" required>
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label small text-muted mb-1" for="fHasta">Hasta</label>
                        <input class="form-control" type="date" id="fHasta" required>
                    </div>
                    <div class="col-12 col-md-6 d-flex flex-wrap gap-2">
                        <button class="btn btn-primary" type="submit" id="btnConsultar"><i class="bi bi-search me-1"></i>Consultar</button>
                        <button class="btn btn-outline-secondary js-rapido" type="button" data-rango="hoy">Hoy</button>
                        <button class="btn btn-outline-secondary js-rapido" type="button" data-rango="7">7 días</button>
                        <button class="btn btn-outline-secondary js-rapido" type="button" data-rango="mes">Este mes</button>
                    </div>
                </form>
            </div>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-md-4"><div class="card border-0 shadow-sm rounded-4"><div class="card-body">
                <div class="small text-muted">Ventas totales</div><div class="fs-3 fw-bold text-success" id="kVentas">—</div>
            </div></div></div>
            <div class="col-md-4"><div class="card border-0 shadow-sm rounded-4"><div class="card-body">
                <div class="small text-muted">Facturas</div><div class="fs-3 fw-bold" id="kFacturas">—</div>
            </div></div></div>
            <div class="col-md-4"><div class="card border-0 shadow-sm rounded-4"><div class="card-body">
                <div class="small text-muted">Ticket promedio</div><div class="fs-3 fw-bold" id="kTicket">—</div>
            </div></div></div>
        </div>

        <div class="row g-4 mb-4">
            <div class="col-lg-7">
                <div class="card border-0 shadow-sm rounded-4 h-100"><div class="card-body">
                    <h5 class="fw-bold mb-3">Ventas por día</h5>
                    <div style="height:280px"><canvas id="chDiario"></canvas></div>
                </div></div>
            </div>
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm rounded-4 h-100"><div class="card-body">
                    <h5 class="fw-bold mb-3">Ventas por local</h5>
                    <div style="height:280px"><canvas id="chLocales"></canvas></div>
                </div></div>
            </div>
        </div>

        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm rounded-4"><div class="card-body">
                    <h5 class="fw-bold mb-3">Comparativo por local</h5>
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead><tr><th>Local</th><th class="text-end">Ventas</th><th class="text-end">Facturas</th><th class="text-end">Ticket prom.</th><th class="text-end">% del total</th></tr></thead>
                            <tbody id="tbodyLocales"><tr><td colspan="5" class="text-muted text-center py-4">Cargando…</td></tr></tbody>
                        </table>
                    </div>
                </div></div>
            </div>
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm rounded-4"><div class="card-body">
                    <h5 class="fw-bold mb-3">Medios de pago</h5>
                    <div class="table-responsive">
                        <table class="table align-middle mb-0">
                            <thead><tr><th>Medio</th><th class="text-end">Facturas</th><th class="text-end">Total</th></tr></thead>
                            <tbody id="tbodyMedios"><tr><td colspan="3" class="text-muted text-center py-4">Cargando…</td></tr></tbody>
                        </table>
                    </div>
                </div></div>
            </div>
        </div>
    </div>

    <%- include('../partials/layout/scripts', { jquery: true, swal: true, chart: true }) %>
    <script src="/js/modulos/sucursales-consolidado.js?v=<%= assetV %>"></script>
</body>

</html>
