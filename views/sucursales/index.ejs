<%- include('../partials/layout/head', { titulo: 'Sucursales - ' + tenant.nombre }) %>
</head>

<body class="bg-light">
    <%- include('../partials/navbar', { user: user, tenant: tenant }) %>

    <div class="container py-4" id="sucursalesApp">
        <div class="mb-4">
            <h2 class="fw-bold"><i class="bi bi-diagram-3 me-2 text-primary"></i>Sucursales</h2>
            <p class="text-muted mb-0">
                Crea sucursales de <strong><%= tenant.nombre %></strong>. Cada una funciona como un restaurante
                independiente, con su propio administrador, productos, mesas y caja.
            </p>
        </div>

        <div class="row g-4">
            <div class="col-lg-7">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="fw-bold mb-0">Mis sucursales</h5>
                            <span class="badge text-bg-light" id="cupo">—</span>
                        </div>
                        <div class="table-responsive">
                            <table class="table align-middle mb-0">
                                <thead>
                                    <tr><th>Sucursal</th><th>Ciudad</th><th>Administrador</th><th>Estado</th></tr>
                                </thead>
                                <tbody id="tbodySucursales">
                                    <tr><td colspan="4" class="text-muted text-center py-4">Cargando…</td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="card border-0 shadow-sm rounded-4">
                    <div class="card-body">
                        <h5 class="fw-bold mb-3">Nueva sucursal</h5>
                        <form id="formSucursal" class="row g-3" autocomplete="off">
                            <div class="col-12">
                                <label class="form-label small text-muted mb-1" for="sNombre">Nombre de la sucursal</label>
                                <input class="form-control" id="sNombre" maxlength="100" required>
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label small text-muted mb-1" for="sCiudad">Ciudad</label>
                                <input class="form-control" id="sCiudad" maxlength="100">
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label small text-muted mb-1" for="sTelefono">Teléfono</label>
                                <input class="form-control" id="sTelefono" maxlength="30">
                            </div>
                            <div class="col-12">
                                <label class="form-label small text-muted mb-1" for="sDireccion">Dirección</label>
                                <input class="form-control" id="sDireccion" maxlength="255">
                            </div>

                            <div class="col-12"><hr class="my-1"><div class="small fw-semibold">Administrador de la sucursal</div></div>
                            <div class="col-12">
                                <label class="form-label small text-muted mb-1" for="aNombre">Nombre completo</label>
                                <input class="form-control" id="aNombre" maxlength="100">
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label small text-muted mb-1" for="aUsername">Usuario</label>
                                <input class="form-control" id="aUsername" maxlength="30" required autocomplete="off">
                            </div>
                            <div class="col-sm-6">
                                <label class="form-label small text-muted mb-1" for="aPassword">Contraseña</label>
                                <input class="form-control" id="aPassword" type="password" minlength="8" required autocomplete="new-password">
                            </div>
                            <div class="col-12">
                                <label class="form-label small text-muted mb-1" for="aEmail">Correo</label>
                                <input class="form-control" id="aEmail" type="email" maxlength="100" required>
                                <div class="form-text">Mínimo 8 caracteres. Compártela con el administrador por un canal seguro.</div>
                            </div>
                            <div class="col-12 text-end">
                                <button class="btn btn-primary" type="submit" id="btnCrear">
                                    <i class="bi bi-plus-lg me-1"></i>Crear sucursal
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <%- include('../partials/layout/scripts', { jquery: true, swal: true }) %>
    <script src="/js/modulos/sucursales.js?v=<%= assetV %>"></script>
</body>

</html>
