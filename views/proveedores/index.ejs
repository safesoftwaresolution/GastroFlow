<%- include('../partials/layout/head', { titulo: 'Gestión de Proveedores - ' + tenant.nombre }) %>
    <link rel="stylesheet" href="/css/modulos/proveedores.css?v=<%= assetV %>">
</head>

<body class="bg-light">
    <%- include('../partials/navbar', { user: user, tenant: tenant }) %>

        <div class="container py-4">
            <div class="row mb-4">
                <div class="col-md-6">
                    <h2 class="fw-bold"><i class="bi bi-truck me-2 text-primary"></i>Proveedores</h2>
                    <p class="text-muted">Gestiona las empresas que suministran tus insumos.</p>
                </div>
                <div class="col-md-6 text-md-end">
                    <button class="btn btn-primary" id="btnNuevoProveedor" data-bs-toggle="modal" data-bs-target="#proveedorModal">
                        <i class="bi bi-plus-lg me-1"></i>Nuevo Proveedor
                    </button>
                </div>
            </div>

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-0" id="proveedoresContainer">
                    <%- include('_table', { proveedores: proveedores }) %>
                </div>
            </div>
        </div>

        <%- include('_modal_form') %>
            <%- include('_modal_facturas') %>
                <%- include('_modal_historial') %>

                    <%- include('../partials/layout/scripts', { jquery: true, swal: true }) %>
                    <script src="/js/modulos/proveedores/proveedores_core.js?v=<%= assetV %>"></script>
                    <script src="/js/modulos/proveedores/proveedores_ui.js?v=<%= assetV %>"></script>
</body>

</html>