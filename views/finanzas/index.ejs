<%- include('../partials/layout/head', { titulo: 'Estado de Resultados | Finanzas Corporativas' }) %>
    <%- include('../partials/layout/scripts', { swal: true, chart: true }) %>
    <link rel="stylesheet" href="/css/modulos/finanzas.css?v=<%= assetV %>">
</head>
<body>
    <%- include('../partials/navbar', { user, tenant, allowedByPlan }) %>

    <div class="container py-4">
        <!-- Header Corporativo -->
        <div class="d-flex justify-content-between align-items-end mb-4 border-bottom pb-3">
            <div>
                <h1 class="fw-bold h4 mb-1">Estado de Resultados</h1>
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0" style="font-size: 0.8rem;">
                        <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Sistema</a></li>
                        <li class="breadcrumb-item active">Finanzas</li>
                    </ol>
                </nav>
            </div>
            <div class="d-flex gap-3 align-items-center">
                <div class="text-end me-3 d-none d-md-block">
                    <div class="small text-muted">Periodo de Análisis</div>
                    <div class="fw-bold small">Últimos <%= dias %> días</div>
                </div>
                <select class="form-select form-select-sm" style="width: auto;" onchange="location.href='?dias='+this.value">
                    <option value="7" <%= dias == 7 ? 'selected' : '' %>>Semana Actual</option>
                    <option value="30" <%= dias == 30 ? 'selected' : '' %>>Mes Contable</option>
                    <option value="90" <%= dias == 90 ? 'selected' : '' %>>Trimestre</option>
                </select>
                <a class="btn btn-outline-dark btn-finance" href="/finanzas/exportar-pdf?dias=<%= dias %>">
                    <i class="bi bi-file-earmark-pdf me-2"></i>Exportar PDF
                </a>
                <button class="btn btn-dark btn-finance" data-bs-toggle="modal" data-bs-target="#modalNuevoGasto">
                    <i class="bi bi-plus-lg me-2"></i>Registrar Operación
                </button>
            </div>
        </div>

        <%
            // Badge de variación vs. el periodo anterior (mismo largo, inmediatamente antes).
            const variacionBadge = (pct, bienSiSube = true) => {
                if (pct === null || pct === undefined) return '';
                const sube = pct >= 0;
                const bueno = sube === bienSiSube;
                const color = bueno ? 'text-success' : 'text-danger';
                const icono = sube ? 'bi-arrow-up-short' : 'bi-arrow-down-short';
                return `<span class="small fw-bold ${color}"><i class="bi ${icono}"></i>${Math.abs(pct).toFixed(1)}%</span> <span class="small text-muted">vs. periodo anterior</span>`;
            };
        %>

        <!-- Fila de KPIs Sobrios -->
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <div class="card card-finance sidebar-success p-3">
                    <div class="kpi-title mb-1">Ingresos Operativos</div>
                    <div class="kpi-value text-success">$<%= Number(resumen.ingresos).toLocaleString('es-CO') %></div>
                    <div class="small text-muted mt-2"><%- variacionBadge(resumen.variacionIngresos, true) %></div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card card-finance sidebar-danger p-3">
                    <div class="kpi-title mb-1">Costos y Gastos</div>
                    <div class="kpi-value text-danger">$<%= Number(resumen.egresos).toLocaleString('es-CO') %></div>
                    <div class="small text-muted mt-2"><%- variacionBadge(resumen.variacionEgresos, false) %></div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card card-finance sidebar-border p-3">
                    <div class="kpi-title mb-1">Utilidad del Ejercicio</div>
                    <div class="kpi-value <%= resumen.utilidad >= 0 ? 'text-primary' : 'text-danger' %>">
                        $<%= Number(resumen.utilidad).toLocaleString('es-CO') %>
                    </div>
                    <div class="small text-muted mt-2"><%- variacionBadge(resumen.variacionUtilidad, true) %></div>
                </div>
            </div>
        </div>

        <div class="row g-3">
            <!-- Gráfico de Tendencia Lineal (Más Profesional) -->
            <div class="col-lg-8">
                <div class="card card-finance p-4">
                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <h6 class="fw-bold mb-0">Flujo de Caja Diario</h6>
                        <div class="small text-muted">Ingresos vs Egresos</div>
                    </div>
                    <div class="chart-container">
                        <canvas id="chartTendencia"></canvas>
                    </div>
                </div>
            </div>

            <!-- Desglose de Gastos -->
            <div class="col-lg-4">
                <div class="card card-finance h-100 p-4">
                    <h6 class="fw-bold mb-4">Gastos por Centro de Costo</h6>
                    <% if (resumen.gastosPorCategoria && resumen.gastosPorCategoria.length > 0) { %>
                        <div class="chart-container mb-4" style="height: 180px;">
                            <canvas id="chartCategorias"></canvas>
                        </div>
                        <div class="mt-auto">
                            <% resumen.gastosPorCategoria.forEach(cat => { 
                                let pct = (cat.total / resumen.egresos) * 100;
                            %>
                                <div class="mb-2">
                                    <div class="d-flex justify-content-between small mb-1">
                                        <span class="text-muted"><%= cat.categoria_gasto %></span>
                                        <span class="fw-bold">$<%= Number(cat.total).toLocaleString('es-CO') %></span>
                                    </div>
                                    <div class="progress" style="height: 4px;">
                                        <div class="progress-bar bg-secondary" style="width: <%= pct %>%"></div>
                                    </div>
                                </div>
                            <% }) %>
                        </div>
                    <% } else { %>
                        <div class="text-center py-5 text-muted small">No se registran egresos.</div>
                    <% } %>
                </div>
            </div>

            <!-- Desglose de Egresos Totales -->
            <div class="col-lg-6 mt-4">
                <div class="card card-finance h-100 p-4">
                    <h6 class="fw-bold mb-3">Desglose de Egresos Totales</h6>
                    <div class="d-flex justify-content-between small mb-2 pb-2 border-bottom">
                        <span class="text-muted">Caja (inventario, gastos manuales)</span>
                        <span class="fw-bold">$<%= Number(resumen.egresosCaja).toLocaleString('es-CO') %></span>
                    </div>
                    <div class="d-flex justify-content-between small mb-2 pb-2 border-bottom">
                        <span class="text-muted">Costos fijos (prorrateado)</span>
                        <span class="fw-bold">$<%= Number(resumen.costosFijosPeriodo).toLocaleString('es-CO') %></span>
                    </div>
                    <div class="d-flex justify-content-between small">
                        <span class="text-muted">Facturas de proveedor del periodo</span>
                        <span class="fw-bold">$<%= Number(resumen.proveedoresPeriodo).toLocaleString('es-CO') %></span>
                    </div>
                </div>
            </div>

            <!-- Ingresos por Forma de Pago -->
            <div class="col-lg-6 mt-4">
                <div class="card card-finance h-100 p-4">
                    <h6 class="fw-bold mb-3">Ingresos por Forma de Pago</h6>
                    <div class="d-flex justify-content-between small mb-2 pb-2 border-bottom">
                        <span class="text-muted"><i class="bi bi-cash-coin me-1"></i>Efectivo</span>
                        <span class="fw-bold">$<%= Number(resumen.desglosePago.efectivo).toLocaleString('es-CO') %></span>
                    </div>
                    <div class="d-flex justify-content-between small mb-2 pb-2 border-bottom">
                        <span class="text-muted"><i class="bi bi-credit-card me-1"></i>Transferencia</span>
                        <span class="fw-bold">$<%= Number(resumen.desglosePago.transferencia).toLocaleString('es-CO') %></span>
                    </div>
                    <div class="d-flex justify-content-between small">
                        <span class="text-muted"><i class="bi bi-gift me-1"></i>Bonos redimidos</span>
                        <span class="fw-bold">$<%= Number(resumen.desglosePago.bono).toLocaleString('es-CO') %></span>
                    </div>
                </div>
            </div>

            <!-- Cuentas por Pagar -->
            <div class="col-12 mt-4">
                <div class="card card-finance">
                    <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                        <h6 class="fw-bold mb-0">Cuentas por Pagar Pendientes</h6>
                        <% const totalPorPagar = (resumen.cuentasPorPagar || []).reduce((s, f) => s + Number(f.monto_total), 0); %>
                        <span class="small text-muted">Total: <strong class="text-danger">$<%= totalPorPagar.toLocaleString('es-CO') %></strong></span>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-finance table-hover mb-0">
                            <thead>
                                <tr>
                                    <th class="ps-4">Proveedor</th>
                                    <th>N° Factura</th>
                                    <th>Vence</th>
                                    <th class="text-end pe-4">Monto</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (resumen.cuentasPorPagar && resumen.cuentasPorPagar.length > 0) { %>
                                    <% resumen.cuentasPorPagar.forEach(f => {
                                        const vencida = f.fecha_vencimiento && new Date(f.fecha_vencimiento) < new Date(new Date().toDateString());
                                    %>
                                        <tr>
                                            <td class="ps-4"><%= f.proveedor_nombre %></td>
                                            <td class="text-muted"><%= f.numero_factura || '-' %></td>
                                            <td>
                                                <% if (f.fecha_vencimiento) { %>
                                                    <span class="<%= vencida ? 'text-danger fw-bold' : 'text-muted' %>">
                                                        <%= new Date(f.fecha_vencimiento).toLocaleDateString('es-CO') %><%= vencida ? ' (vencida)' : '' %>
                                                    </span>
                                                <% } else { %>
                                                    <span class="text-muted">Sin fecha</span>
                                                <% } %>
                                            </td>
                                            <td class="text-end pe-4 fw-bold">$<%= Number(f.monto_total).toLocaleString('es-CO') %></td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="4" class="text-center py-4 text-muted">No hay cuentas por pagar pendientes.</td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Libro Diario (Transacciones Recientes) -->
            <div class="col-12 mt-4">
                <div class="card card-finance">
                    <div class="card-header bg-white py-3">
                        <h6 class="fw-bold mb-0">Libro Diario - Últimas Transacciones</h6>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-finance table-hover mb-0">
                            <thead>
                                <tr>
                                    <th class="ps-4">Fecha</th>
                                    <th>Concepto / Motivo</th>
                                    <th>Categoría</th>
                                    <th>Referencia</th>
                                    <th class="text-end pe-4">Monto</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (resumen.movimientos && resumen.movimientos.length > 0) { %>
                                    <% resumen.movimientos.forEach(m => { %>
                                        <tr>
                                            <td class="ps-4 text-muted"><%= new Date(m.created_at).toLocaleString('es-CO') %></td>
                                            <td>
                                                <span class="badge badge-type <%= m.tipo === 'entrada' ? 'bg-success' : 'bg-danger' %> me-2">
                                                    <%= m.tipo.toUpperCase() %>
                                                </span>
                                                <%= m.motivo %>
                                            </td>
                                            <td class="text-muted"><%= m.categoria_gasto %></td>
                                            <td><small class="text-muted"><%= m.referencia_tipo %> #<%= m.referencia_id || 'N/A' %></small></td>
                                            <td class="text-end pe-4 fw-bold <%= m.tipo === 'entrada' ? 'text-success' : 'text-danger' %>">
                                                <%= m.tipo === 'entrada' ? '+' : '-' %>$<%= Number(m.monto).toLocaleString('es-CO') %>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="5" class="text-center py-4 text-muted">No hay transacciones recientes.</td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Nuevo Gasto -->
    <div class="modal fade" id="modalNuevoGasto" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content border-0 shadow">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title h6 fw-bold">Nueva Operación Financiera</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <form id="formGasto">
                        <div class="mb-3">
                            <label for="gastoTipo" class="form-label small fw-bold">Tipo de Operación</label>
                            <select class="form-select" id="gastoTipo">
                                <option value="salida">EGRESO (Gasto / Pago)</option>
                                <option value="entrada">INGRESO (Inyección / Otro)</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="gastoMonto" class="form-label small fw-bold">Monto del Movimiento</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <input type="text" inputmode="decimal" class="form-control money-input" id="gastoMonto" required placeholder="0">
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="gastoCategoria" class="form-label small fw-bold">Centro de Costo / Categoría</label>
                            <select class="form-select" id="gastoCategoria">
                                <option value="General">General</option>
                                <option value="Servicios">Servicios Públicos</option>
                                <option value="Nómina">Nómina / Sueldos</option>
                                <option value="Arriendo">Arriendo</option>
                                <option value="Insumos">Compra de Insumos</option>
                                <option value="Mantenimiento">Mantenimiento</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="gastoMotivo" class="form-label small fw-bold">Justificación Comercial</label>
                            <textarea class="form-control" id="gastoMotivo" rows="2" placeholder="Ej: Pago de factura energía eléctrica abril 2024"></textarea>
                        </div>
                    </form>
                </div>
                <div class="modal-footer border-0">
                    <button type="button" class="btn btn-light btn-sm fw-bold" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-dark btn-sm fw-bold px-4" onclick="guardarGasto()">Confirmar Registro</button>
                </div>
            </div>
        </div>
    </div>

    <script type="application/json" id="finanzas-data"><%- jsonSeguro({ historico: resumen.historico || [], gastosPorCategoria: resumen.gastosPorCategoria || [] }) %></script>
    <script src="/js/core/money-input.js?v=<%= assetV %>"></script>
    <script src="/js/modulos/finanzas.js?v=<%= assetV %>"></script>
</body>
</html>
