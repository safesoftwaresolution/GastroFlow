<%- include('../partials/layout/head', { titulo: 'Soporte Técnico' }) %>
    <link rel="stylesheet" href="/css/modulos/soporte.css?v=<%= assetV %>">
</head>

<body class="bg-light">
    <%- include('../partials/navbar', { user: user, tenant: tenant }) %>

        <div class="container mt-4 mb-5">
            <h2 class="mb-4"><i class="bi bi-headset me-2"></i>Soporte Técnico</h2>

            <div class="row g-4">
                <!-- Formulario de Ticket -->
                <div class="col-md-5">
                    <div class="card shadow-sm h-100">
                        <div class="card-header bg-white">
                            <h5 class="card-title mb-0"><i class="bi bi-envelope-plus me-2"></i>Crear Nuevo Ticket</h5>
                        </div>
                        <div class="card-body">
                            <form id="soporteForm">
                                <div class="mb-3">
                                    <label for="soporteTipo" class="form-label">Tipo de Solicitud</label>
                                    <select class="form-select" id="soporteTipo" name="tipo" required>
                                        <option value="">Seleccione una opción...</option>
                                        <option value="bug">🐞 Reportar un Error (Bug)</option>
                                        <option value="mejora">💡 Sugerir una Mejora</option>
                                        <option value="duda">❓ Duda o Consulta General</option>
                                        <option value="urgente">🆘 Ayuda Urgente</option>
                                    </select>
                                </div>
                                <div class="mb-3">
                                    <label for="soporteDescripcion" class="form-label">Descripción</label>
                                    <textarea class="form-control" id="soporteDescripcion" name="descripcion" rows="5" placeholder="Por favor explica detalladamente tu solicitud, error o consulta..." required></textarea>
                                </div>
                                <div class="d-grid">
                                    <button type="submit" class="btn btn-primary" id="btnSubmit">
                                        <i class="bi bi-send me-1"></i> Enviar Ticket
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- Historial de Tickets -->
                <div class="col-md-7">
                    <div class="card shadow-sm h-100">
                        <div class="card-header bg-white">
                            <h5 class="card-title mb-0"><i class="bi bi-journal-text me-2"></i>Mis Tickets Recientes</h5>
                        </div>
                        <div class="card-body p-0">
                            <% if (tickets && tickets.length > 0) { %>
                                <div class="table-responsive">
                                    <table class="table table-hover mb-0">
                                        <thead class="table-light">
                                            <tr>
                                                <th>#</th>
                                                <th>Tipo</th>
                                                <th>Estado</th>
                                                <th>Fecha</th>
                                                <th>Acción</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% tickets.forEach(t => { %>
                                                <tr>
                                                    <td><%= t.id %></td>
                                                    <td><span class="badge bg-secondary"><%= t.tipo.toUpperCase() %></span></td>
                                                    <td><span class="badge ticket-status-<%= t.estado %>"><%= t.estado.replace('_', ' ').toUpperCase() %></span></td>
                                                    <td><%= new Date(t.created_at).toLocaleDateString() %></td>
                                                    <td>
                                                        <button class="btn btn-sm btn-outline-info btn-ver" 
                                                                data-bs-toggle="modal" data-bs-target="#ticketModal"
                                                                data-id="<%= t.id %>"
                                                                data-tipo="<%= t.tipo %>"
                                                                data-estado="<%= t.estado %>"
                                                                data-desc="<%= t.descripcion %>"
                                                                data-resp="<%= t.respuesta_admin || 'Aún no hay respuesta del administrador.' %>">
                                                            <i class="bi bi-eye"></i> Ver
                                                        </button>
                                                    </td>
                                                </tr>
                                            <% }) %>
                                        </tbody>
                                    </table>
                                </div>
                            <% } else { %>
                                <div class="text-center p-5 text-muted">
                                    <i class="bi bi-inbox fs-1 mb-3 d-block"></i>
                                    <p>Aún no has creado ningún ticket de soporte.</p>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Modal para ver el ticket -->
        <div class="modal fade" id="ticketModal" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Detalles del Ticket #<span id="modalTicketId"></span></h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3">
                            <span class="badge bg-secondary" id="modalTicketTipo"></span>
                            <span class="badge" id="modalTicketEstado"></span>
                        </div>
                        <h6>Tu Mensaje:</h6>
                        <div class="p-3 bg-light rounded mb-3" style="white-space: pre-wrap;" id="modalTicketDesc"></div>
                        
                        <h6>Respuesta de Soporte:</h6>
                        <div class="p-3 bg-info bg-opacity-10 border border-info rounded" style="white-space: pre-wrap;" id="modalTicketResp"></div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                    </div>
                </div>
            </div>
        </div>

        <%- include('../partials/layout/scripts', { swal: true }) %>
        <script src="/js/modulos/soporte.js?v=<%= assetV %>"></script>
</body>
</html>
