<%# PWA: manifest, color de barra y banner "Instalar GastroFlow" (public/js/core/pwa-install.js). %>
<link rel="manifest" href="<%= typeof manifestUrl !== 'undefined' ? manifestUrl : '/manifest.webmanifest' %>">
<meta name="theme-color" content="#080b09">
<link rel="apple-touch-icon" href="/icons/icon-192.png">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-title" content="<%= typeof appTitle !== 'undefined' ? appTitle : 'GastroFlow' %>">
<script src="/js/core/pwa-install.js?v=<%= assetV %>" defer></script>
