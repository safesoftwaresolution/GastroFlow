<%#
  Librerías base al final del body, siempre en el mismo orden y versión.
  Bootstrap va siempre; el resto según lo que use la página, por ejemplo:
    include('../partials/layout/scripts', { jquery: true, swal: true, chart: true })
  Después van los scripts propios de la página.
%>
<% if (typeof jquery !== 'undefined' && jquery) { %>    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<% } %>    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<% if (typeof swal !== 'undefined' && swal) { %>    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<% } %><% if (typeof chart !== 'undefined' && chart) { %>    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<% } %>
