<%- include('../partials/layout/auth-head', { titulo: (title || 'Local en revisión') + ' - Sistema de Restaurante' }) %>
<body>
    <main class="login-form-side" style="width:100%;">
        <div class="login-card" style="text-align:center;">
            <a href="/" class="mobile-logo" style="text-decoration: none; justify-content:center;">
                <div class="mobile-logo-icon"><i class="bi bi-shop"></i></div>
                <span class="mobile-logo-text">GastroFlow</span>
            </a>

            <div style="font-size:3rem;color:#f59e0b;margin:1rem 0;">
                <i class="bi bi-hourglass-split"></i>
            </div>

            <h1 class="login-title">¡Tu local fue creado!</h1>
            <p class="login-subtitle">
                Está en revisión. Te avisaremos por correo apenas sea aprobado
                y podrás empezar a usar GastroFlow.
            </p>

            <p class="login-footer" style="margin-top:1.5rem;">
                <a href="/auth/logout" style="color:inherit;font-weight:600;">Cerrar sesión</a>
            </p>
        </div>
    </main>
</body>

</html>
