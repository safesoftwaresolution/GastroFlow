<%- include('../_shell/_open', {
    title: 'Catálogo de Productos',
    currentAdminPage: 'productos',
    pageCss: '/css/admin/productos.css'
}) %>

    <div class="admin-page-header">
        <h1><i class="bi bi-box-seam me-2"></i>Catálogo de Productos</h1>
        <p class="mb-0">Todos los productos de todos los restaurantes, activos e inactivos, con a quién pertenecen y su historial de creación/edición/baja.</p>
    </div>

    <div class="stats-grid mb-4">
        <div class="stat-card">
            <div class="stat-card-header">
                <span class="stat-icon"><i class="bi bi-list-ul"></i></span>
                <span class="stat-title">Productos encontrados</span>
            </div>
            <div class="stat-val"><%= total %></div>
        </div>
    </div>

    <!-- Filtros -->
    <form class="filter-card" method="get" action="/admin/productos">
        <div class="filter-row">
            <div class="filter-field">
                <label class="filter-label">Restaurante</label>
                <select class="form-select form-select-sm" name="tenantId" onchange="this.form.submit()">
                    <option value="">Todos</option>
                    <% (tenants || []).forEach(t => { %>
                        <option value="<%= t.id %>" <%= filtros.tenantId === t.id ? 'selected' : '' %>><%= t.nombre %></option>
                    <% }) %>
                </select>
            </div>
            <div class="filter-field">
                <label class="filter-label">Estado</label>
                <select class="form-select form-select-sm" name="estado" onchange="this.form.submit()">
                    <option value="">Todos</option>
                    <option value="activo" <%= filtros.estado === 'activo' ? 'selected' : '' %>>Activos</option>
                    <option value="inactivo" <%= filtros.estado === 'inactivo' ? 'selected' : '' %>>Inactivos (eliminados)</option>
                </select>
            </div>
            <div class="filter-field flex-grow-1">
                <label class="filter-label">Buscar</label>
                <input type="text" class="form-control form-control-sm" name="q" placeholder="Nombre o código..." value="<%= filtros.q || '' %>">
            </div>
            <div class="filter-field justify-content-end">
                <button type="submit" class="btn btn-sm btn-primary"><i class="bi bi-search me-1"></i>Filtrar</button>
                <a href="/admin/productos" class="btn btn-sm btn-outline-secondary">Limpiar</a>
            </div>
        </div>
    </form>

    <!-- Tabla -->
    <div class="premium-card p-0">
        <div class="table-responsive">
            <table class="table productos-table mb-0">
                <thead>
                    <tr>
                        <th>Producto</th>
                        <th>Restaurante</th>
                        <th>Categoría</th>
                        <th class="text-end">Precio</th>
                        <th>Estado</th>
                        <th>Última modificación</th>
                        <th class="text-end">Detalle</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (productos && productos.length > 0) { %>
                        <% productos.forEach(p => { %>
                            <tr>
                                <td>
                                    <div class="fw-bold"><%= p.nombre %></div>
                                    <div class="small text-muted"><%= p.codigo %></div>
                                </td>
                                <td><%= p.tenant_nombre %></td>
                                <td><%= p.categoria_nombre || '—' %></td>
                                <td class="text-end fw-bold">$<%= Number(p.precio_unidad || 0).toLocaleString('es-CO') %></td>
                                <td>
                                    <% if (p.activo) { %>
                                        <span class="badge-estado activo">Activo</span>
                                    <% } else { %>
                                        <span class="badge-estado inactivo">Eliminado</span>
                                    <% } %>
                                </td>
                                <td class="small text-muted"><%= new Date(p.updated_at).toLocaleString('es-CO') %></td>
                                <td class="text-end">
                                    <button type="button" class="btn btn-sm btn-outline-primary" onclick="verDetalleProducto(<%= p.id %>)">
                                        <i class="bi bi-clock-history me-1"></i>Ver / Auditoría
                                    </button>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr>
                            <td colspan="7" class="text-center py-5 text-muted">No se encontraron productos con esos filtros.</td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Paginación -->
    <% if (totalPaginas > 1) { %>
        <nav class="mt-3">
            <ul class="pagination pagination-sm justify-content-center">
                <% for (let i = 1; i <= totalPaginas; i++) { %>
                    <% const qs = new URLSearchParams({ ...filtros, tenantId: filtros.tenantId || '', page: i }); %>
                    <li class="page-item <%= i === page ? 'active' : '' %>">
                        <a class="page-link" href="/admin/productos?<%= qs.toString() %>"><%= i %></a>
                    </li>
                <% } %>
            </ul>
        </nav>
    <% } %>

    <!-- Modal Detalle + Auditoría -->
    <div class="modal fade" id="modalDetalleProducto" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-box-seam me-2"></i>Detalle del producto</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body" id="detalleProductoBody">
                    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
                </div>
            </div>
        </div>
    </div>

<%- include('../_shell/_close', {
    extraScripts: '<script src="/js/admin/productos.js?v=' + assetV + '"></script>'
}) %>
